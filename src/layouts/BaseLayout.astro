---
// Fonts loaded via @fontsource so nothing is fetched from Google at runtime.
import "@fontsource/cinzel/400.css";
import "@fontsource/cinzel/600.css";
import "@fontsource/cinzel/700.css";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/eb-garamond/400-italic.css";

import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import FloatingCta from "../components/FloatingCta.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Turathi",
  description = "Placeholder description. Bahraini traditional architecture and design.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* TODO: social share image (logo + hero line) once the asset exists. */}
    {/* TODO: Google Analytics + UTM setup goes here. Not wired yet. */}
  </head>
  <body class="min-h-screen flex flex-col">
    {/*
      Global SVG defs reused site-wide: the pointed heritage arch (as an
      objectBoundingBox clip-path so it scales to any placeholder), and the
      eight-point star jewel. Hidden, referenced by id.
    */}
    <svg
      aria-hidden="true"
      focusable="false"
      style="position:absolute;width:0;height:0;overflow:hidden"
    >
      <defs>
        <clipPath id="turathiArch" clipPathUnits="objectBoundingBox">
          <path d="M0,1 L0,0.44 Q0.08,0.03 0.5,0 Q0.92,0.03 1,0.44 L1,1 Z"></path>
        </clipPath>
        <symbol id="turathiStar" viewBox="0 0 24 24">
          <g fill="currentColor">
            <rect x="5.5" y="5.5" width="13" height="13"></rect>
            <rect
              x="5.5"
              y="5.5"
              width="13"
              height="13"
              transform="rotate(45 12 12)"></rect>
          </g>
        </symbol>
      </defs>
    </svg>

    <TopBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <FloatingCta />
  </body>
</html>
