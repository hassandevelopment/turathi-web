---
import BaseLayout from "../layouts/BaseLayout.astro";
import Placeholder from "../components/Placeholder.astro";

// Partners strip placeholders. Real logos added later.
const partners = ["Partner 01", "Partner 02", "Partner 03", "Partner 04"];
---

<BaseLayout
  title="About | Turathi"
  description="I'm Ammar, a Bahraini architect and mechanical engineer. Turathi is the movement I'm building."
>
  <section class="max-w-6xl mx-auto px-4 py-24">
    <div class="grid gap-10 md:grid-cols-2 items-start">
      <div>
        <h1 class="text-3xl sm:text-5xl text-navy">About</h1>
        <p class="mt-6 text-lg text-navy/70 max-w-xl">
          I'm Ammar, a Bahraini architect and mechanical engineer. Turathi is
          what I'm building: a movement for a Bahrain that grows without losing
          itself. I grew up around buildings that knew how to keep you cool,
          bring people together and still feel like they belonged. I want that
          back. Not as nostalgia, but as the better answer we stopped using.
        </p>
      </div>
      {/* Real photo of him pending his shoot. */}
      <Placeholder label="Photo of Ammar" class="w-full aspect-[4/5]" />
    </div>
  </section>

  {/* Works and Projects are folded into About for now, until real client work exists. */}
  <section class="max-w-6xl mx-auto px-4 pb-24">
    <h2 class="text-2xl text-navy">Selected work</h2>
    <p class="mt-3 text-navy/70 max-w-2xl">
      I have no built projects to show yet. That's honest. What I can show is how
      I think and how I draw, and this page will grow as real work lands.
    </p>
    <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4">
      <Placeholder label="Project 01" class="aspect-[4/3]" />
      <Placeholder label="Project 02" class="aspect-[4/3]" />
      <Placeholder label="Project 03" class="aspect-[4/3]" />
    </div>
  </section>

  {/* Partners strip. */}
  <section class="bg-stone/60">
    <div class="max-w-6xl mx-auto px-4 py-16">
      <p class="text-sm uppercase tracking-wider text-navy/50">Partners</p>
      <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
        {partners.map((p) => <Placeholder label={p} class="h-20" />)}
      </div>
    </div>
  </section>
</BaseLayout>
