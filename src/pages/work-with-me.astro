---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Work with me | Turathi"
  description="Work with me on interiors and buildings that belong to Bahrain."
>
  <section class="max-w-4xl mx-auto px-4 py-24">
    <h1 class="text-3xl sm:text-5xl text-navy">Work with me</h1>
    <p class="mt-5 text-lg text-navy/70 max-w-2xl">
      If you are building in Bahrain and you want it to belong here, work with
      me. I take on interiors, buildings and the thinking behind them, and I
      would rather do a few things properly than many things fast.
    </p>

    {/* Contact section lives on this page per the sitemap. */}
    <div id="contact" class="mt-16">
      <h2 class="text-2xl text-navy">Get in touch</h2>
      <p class="mt-3 text-navy/70 max-w-2xl">
        Tell me what you are building and where. I read every message myself.
      </p>

      {/* TODO: contact form (spam-protected, no database, no login) goes here. Not wired yet. */}
      <div
        class="mt-8 border border-dashed border-navy/30 p-10 text-center text-navy/50"
      >
        Contact form placeholder
      </div>
    </div>
  </section>
</BaseLayout>
