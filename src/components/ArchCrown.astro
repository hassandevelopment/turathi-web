---
// Small pointed-arch ornament that tops key cards, so they read as arches
// rather than plain rectangles. Navy line with a brass inner line for carved
// depth. tone="light" for use on navy backgrounds.
interface Props {
  tone?: "dark" | "light";
  class?: string;
}
const { tone = "dark", class: className = "w-12" } = Astro.props;
const outer = tone === "light" ? "#F1E9D8" : "#1B2A6B";
const inner = "#B08A46";
---

<svg viewBox="0 0 48 22" class={`block ${className}`} aria-hidden="true">
  <path
    d="M2,22 L2,13 Q9,2 24,0 Q39,2 46,13 L46,22"
    fill="none"
    stroke={outer}
    stroke-width="1.4"
    stroke-linecap="round"></path>
  <path
    d="M8,22 L8,14 Q13,5 24,3 Q35,5 40,14 L40,22"
    fill="none"
    stroke={inner}
    stroke-width="1"
    stroke-linecap="round"></path>
</svg>
