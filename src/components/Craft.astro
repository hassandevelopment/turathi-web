---
import Button from "./Button.astro";
import Placeholder from "./Placeholder.astro";

// The craft row is proof, not a headline. Grey placeholder boxes stand in
// for his hand drawings until real scans arrive.
const drawings = ["Drawing 01", "Drawing 02", "Drawing 03", "Drawing 04"];
---

<section class="max-w-6xl mx-auto px-4 py-24">
  <p class="text-sm uppercase tracking-wider text-accent">The Craft</p>
  <h2 class="mt-3 text-2xl sm:text-3xl text-navy">His hand drawings</h2>
  <p class="mt-3 text-navy/70 max-w-2xl">
    Placeholder line. Receipts, not headline. A few of his drawings sit here.
  </p>

  <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
    {
      drawings.map((d) => (
        <Placeholder label={d} class="aspect-[3/4]" />
      ))
    }
  </div>

  <div class="mt-10">
    <Button href="/about" variant="outline">See more of the craft</Button>
  </div>
</section>
