---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import Star from "./Star.astro";
---

<section class="mx-auto max-w-6xl px-4 py-24">
  <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
    <div>
      <Eyebrow>Events &amp; Sessions</Eyebrow>
      <h2 class="mt-4 text-2xl text-navy sm:text-3xl">Next session</h2>
      <p class="mt-4 max-w-lg text-navy/70">
        I run sessions and talks where we argue this out in person: how Bahrain
        can grow without losing itself.
      </p>
      <p class="mt-2 max-w-lg text-sm text-navy/50">
        Next date and venue to be confirmed (placeholder).
      </p>
      <div class="mt-8">
        <Button href="/events">Sign up</Button>
      </div>
    </div>

    {/* TODO: Luma embed for sign-ups goes here. Not wired yet. */}
    <div
      class="flex flex-col items-center gap-3 border border-dashed border-brass/50 bg-stone/30 p-10 text-center"
    >
      <Star tone="brass" class="h-5 w-5" />
      <span class="font-display text-[0.62rem] uppercase tracking-[0.28em] text-navy/50">
        Luma sign-up embed placeholder
      </span>
    </div>
  </div>
</section>
