---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import ArchImage from "./ArchImage.astro";
import blueDoor from "../assets/heritage/blue-door.jpg";
---

<section class="border-y border-brass/15 bg-stone/50 naqsh">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 md:grid-cols-2">
    <div>
      <Eyebrow>The Movement</Eyebrow>
      <h2 class="mt-4 text-2xl text-navy sm:text-3xl">
        Rebuilding the Islamic Renaissance
      </h2>
      <p class="mt-4 max-w-lg text-navy/70">
        In the rush to rebuild quickly and cheaply, we dropped ornament, craft
        and meaning. Glass towers and lifeless blocks replaced human buildings.
        I want to bring that meaning back.
      </p>
      <div class="mt-8">
        <Button href="/the-movement" variant="outline">Read the movement</Button>
      </div>
    </div>
    <ArchImage
      src={blueDoor}
      alt="Weathered blue-grey door of a Bahraini heritage house"
      class="mx-auto w-full max-w-sm aspect-[4/5]"
    />
  </div>
</section>
