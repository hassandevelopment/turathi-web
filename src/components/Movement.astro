---
import Button from "./Button.astro";
import Placeholder from "./Placeholder.astro";
---

<section class="bg-stone/60">
  <div class="max-w-6xl mx-auto px-4 py-24 grid gap-10 md:grid-cols-2 items-center">
    <div>
      <p class="text-sm uppercase tracking-wider text-accent">The Movement</p>
      <h2 class="mt-3 text-2xl sm:text-3xl text-navy">
        Rebuilding the Islamic Renaissance
      </h2>
      <p class="mt-4 text-navy/70 max-w-lg">
        Placeholder teaser for the movement. A couple of sentences of his
        philosophy, then a link through to the full page.
      </p>
      <div class="mt-8">
        <Button href="/the-movement" variant="outline">Read the movement</Button>
      </div>
    </div>
    <Placeholder label="Movement image" class="w-full aspect-[4/3]" />
  </div>
</section>
