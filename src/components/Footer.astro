---
// TODO: confirm real Substack URL and social handles.
const journalUrl = "https://turathi.substack.com";
const socials = [
  { label: "Instagram", href: "https://instagram.com/turathi.bh" },
  { label: "Journal", href: journalUrl },
];
// TODO: real contact email placeholder until confirmed.
const email = "hello@turathi.example";
---

<footer class="bg-navy text-white mt-24">
  <div class="max-w-6xl mx-auto px-4 py-14 grid gap-10 sm:grid-cols-3">
    <div>
      <p class="font-display text-lg tracking-widest uppercase">Turathi</p>
      <p class="mt-3 text-white/70 text-sm max-w-xs">
        Placeholder footer line. Bahraini heritage, designed for today.
      </p>
    </div>

    <div>
      <p class="text-sm uppercase tracking-wider text-white/50">Contact</p>
      <a href={`mailto:${email}`} class="mt-3 inline-block hover:text-accent"
        >{email}</a
      >
    </div>

    <div>
      <p class="text-sm uppercase tracking-wider text-white/50">Elsewhere</p>
      <ul class="mt-3 space-y-1">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="hover:text-accent"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-white/50">
      &copy; 2026 Turathi. All rights reserved.
    </div>
  </div>
</footer>
