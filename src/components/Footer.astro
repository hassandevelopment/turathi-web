---
import Star from "./Star.astro";

// TODO: confirm real Substack URL and social handles.
const journalUrl = "https://turathi.substack.com";
const socials = [
  { label: "Instagram", href: "https://instagram.com/turathi.bh" },
  { label: "Journal", href: journalUrl },
];
// TODO: real contact email placeholder until confirmed.
const email = "hello@turathi.example";
---

{/*
  The footer sits on the same navy as the closing band above it, so the seam
  is drawn, not assumed: a crisp brass top edge marks the threshold, and a
  crafted ornament (an eight-point star breaking a pair of tapering hairlines)
  announces where the footer begins.
*/}
<footer class="relative bg-navy text-paper naqsh-light">
  <div class="mx-auto max-w-6xl px-4 pt-16">
    <div class="flex items-center gap-6" aria-hidden="true">
      <span class="h-px flex-1 bg-gradient-to-r from-transparent to-brass/50"></span>
      <Star tone="brass" class="h-5 w-5 shrink-0" />
      <span class="h-px flex-1 bg-gradient-to-l from-transparent to-brass/50"></span>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 pb-14 pt-12 text-center">
    <div class="flex items-center justify-center gap-2.5">
      <Star tone="brass" class="h-4 w-4" />
      <p class="font-display text-lg uppercase tracking-[0.2em]">Turathi</p>
    </div>
    <p class="mx-auto mt-4 max-w-md text-sm text-paper/70">
      I design a Bahrain that still feels like Bahrain. Heritage, made for how we
      live now.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-8 sm:flex-row sm:gap-16">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-brass">Contact</p>
        <a
          href={`mailto:${email}`}
          class="mt-2 inline-block underline-offset-8 decoration-brass transition-colors duration-150 hover:text-white hover:underline"
          >{email}</a
        >
      </div>

      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-brass">Elsewhere</p>
        <ul class="mt-2 space-y-1">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="underline-offset-8 decoration-brass transition-colors duration-150 hover:text-white hover:underline"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-brass/20">
    <div class="mx-auto max-w-6xl px-4 py-6 text-center text-sm text-paper/50">
      &copy; 2026 Turathi. All rights reserved.
    </div>
  </div>
</footer>
