---
import Star from "./Star.astro";

// TODO: confirm real Substack URL and social handles.
const journalUrl = "https://turathi.substack.com";
const socials = [
  { label: "Instagram", href: "https://instagram.com/turathi.bh" },
  { label: "Journal", href: journalUrl },
];
// TODO: real contact email placeholder until confirmed.
const email = "hello@turathi.example";
---

<footer class="mt-24 bg-navy text-paper naqsh-light">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-3">
    <div>
      <div class="flex items-center gap-2.5">
        <Star tone="brass" class="h-4 w-4" />
        <p class="font-display text-lg uppercase tracking-[0.2em]">Turathi</p>
      </div>
      <p class="mt-3 max-w-xs text-sm text-paper/70">
        I design a Bahrain that still feels like Bahrain. Heritage, made for how
        we live now.
      </p>
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-brass">Contact</p>
      <a
        href={`mailto:${email}`}
        class="mt-3 inline-block underline-offset-8 decoration-brass hover:underline"
        >{email}</a
      >
    </div>

    <div>
      <p class="text-xs uppercase tracking-[0.25em] text-brass">Elsewhere</p>
      <ul class="mt-3 space-y-1">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="underline-offset-8 decoration-brass hover:underline"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-brass/20">
    <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-paper/50">
      &copy; 2026 Turathi. All rights reserved.
    </div>
  </div>
</footer>
