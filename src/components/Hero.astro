---
import Button from "./Button.astro";
import Placeholder from "./Placeholder.astro";
---

<section class="relative">
  {/* Heritage image sits behind the hero. Grey placeholder box for now. */}
  <Placeholder
    label="Hero heritage image"
    class="absolute inset-0 w-full h-full"
  />

  <div class="relative max-w-6xl mx-auto px-4 py-28 sm:py-40">
    <div class="max-w-3xl bg-white/85 backdrop-blur-sm p-8 sm:p-10">
      <h1 class="text-3xl sm:text-5xl leading-tight text-navy">
        Bahrain can grow without losing what makes it Bahrain.
      </h1>
      <p class="mt-5 text-lg text-navy/70">
        I design homes, buildings and neighbourhoods that grow with Bahrain
        without letting go of what makes it ours.
      </p>
      <div class="mt-8">
        <Button href="/work-with-me">Work with me</Button>
      </div>
    </div>
  </div>
</section>
