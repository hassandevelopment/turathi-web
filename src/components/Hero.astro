---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Fanlight from "./Fanlight.astro";
import courtyard from "../assets/heritage/courtyard.jpg";
---

<section class="relative overflow-hidden">
  {/* Full-bleed heritage courtyard. Eager: this is the LCP image. */}
  <Image
    src={courtyard}
    alt="Courtyard of a traditional Bahraini heritage house"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 h-full w-full object-cover"
  />
  {/* Navy wash plus a gentle top-to-bottom deepening so the words stay crisp. */}
  <div class="absolute inset-0 bg-navy/55"></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-navy/30 via-transparent to-navy/70"
  >
  </div>

  {/* Content in normal flow, centred, tall padding for a full-bleed feel. */}
  <div
    class="relative mx-auto max-w-3xl px-4 py-32 text-center text-paper sm:py-44"
  >
    {/* The stained-glass jewel, crowning the hero. */}
    <Fanlight class="mx-auto mb-8 w-24" />
    <h1 class="text-balance text-3xl leading-tight sm:text-5xl md:text-6xl">
      Bahrain can grow without losing what makes it Bahrain.
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-paper/85">
      I design homes, buildings and neighbourhoods that grow with Bahrain
      without letting go of what makes it ours.
    </p>
    <div class="mt-10 flex justify-center">
      <Button href="/work-with-me">Work with me</Button>
    </div>
  </div>
</section>
