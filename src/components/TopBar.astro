---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import { withBase } from "../lib/url";
import mark from "../assets/turathi-mark.png";

// Internal nav plus one external link out to the Journal (Substack).
const navLinks = [
  { label: "The Movement", href: "/the-movement" },
  { label: "Events & Sessions", href: "/events" },
  { label: "The Turathi Octagon", href: "/the-turathi-octagon" },
  { label: "About", href: "/about" },
];

// TODO: confirm real Substack URL. Journal is an external link, not a page.
const journalUrl = "https://turathi.substack.com";
---

<header class="sticky top-0 z-40 border-b border-brass/25 bg-paper/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href={withBase("/")} class="flex items-center gap-3" aria-label="Turathi home">
      {/* Ammar's real door-motif logo mark (navy square, white line drawing). */}
      <Image
        src={mark}
        alt="Turathi"
        width={80}
        height={80}
        class="h-10 w-10 ring-1 ring-brass/40"
      />
      <span class="font-display text-lg uppercase tracking-[0.2em] text-navy"
        >Turathi</span
      >
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex">
      {
        navLinks.map((link) => (
          <a
            href={withBase(link.href)}
            class="text-navy/75 underline-offset-8 decoration-brass transition-colors hover:text-navy hover:underline"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={journalUrl}
        target="_blank"
        rel="noopener"
        class="text-navy/75 underline-offset-8 decoration-brass transition-colors hover:text-navy hover:underline"
      >
        Journal
      </a>
    </nav>

    {/* Hidden on mobile, where the floating button (md:hidden) serves the CTA. */}
    <div class="hidden md:block">
      <Button href="/work-with-me">Work with me</Button>
    </div>

    {/* Mobile menu trigger. The three bars morph into a cross when open. */}
    <button
      id="menu-toggle"
      type="button"
      class="relative flex h-11 w-11 items-center justify-center text-navy md:hidden"
      aria-label="Open menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <span class="menu-bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  {/* Mobile nav panel, toggled by the burger. */}
  <div id="mobile-nav" hidden class="border-t border-brass/25 bg-paper/95 md:hidden">
    <nav class="mx-auto flex max-w-6xl flex-col px-4 py-2">
      {
        navLinks.map((link) => (
          <a
            href={withBase(link.href)}
            class="border-b border-brass/10 py-3.5 text-navy/80 transition-colors hover:text-navy"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={journalUrl}
        target="_blank"
        rel="noopener"
        class="border-b border-brass/10 py-3.5 text-navy/80 transition-colors hover:text-navy"
      >
        Journal
      </a>
      <Button href="/work-with-me" class="mt-4 mb-2 w-full">Work with me</Button>
    </nav>
  </div>
</header>

<style>
  .menu-bars {
    position: relative;
    display: block;
    height: 16px;
    width: 22px;
  }
  .menu-bars span {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    border-radius: 1px;
    background: var(--color-navy);
    transition:
      transform 0.25s ease,
      opacity 0.2s ease,
      top 0.25s ease;
  }
  .menu-bars span:nth-child(1) {
    top: 0;
  }
  .menu-bars span:nth-child(2) {
    top: 7px;
  }
  .menu-bars span:nth-child(3) {
    top: 14px;
  }
  #menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }
  #menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  #mobile-nav:not([hidden]) nav {
    animation: menuIn 0.22s ease-out;
  }
  @keyframes menuIn {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-bars span,
    #mobile-nav:not([hidden]) nav {
      transition-duration: 0.01ms;
      animation-duration: 0.01ms;
    }
  }
</style>

<script>
  const btn = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  if (btn && panel) {
    const setOpen = (open: boolean) => {
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
    };
    btn.addEventListener("click", () =>
      setOpen(btn.getAttribute("aria-expanded") !== "true"),
    );
    panel
      .querySelectorAll("a")
      .forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });
  }
</script>
