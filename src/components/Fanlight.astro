---
// A single restrained jewel: a small stained-glass fanlight, like the coloured
// arched windows over heritage doors. Blue, green, oxblood and gold panes with
// brass leading. Used in ONE place only. Colours are literal here (a one-off
// ornament) and echo the glass tokens in tokens.css.
interface Props {
  class?: string;
}
const { class: className = "w-24" } = Astro.props;
---

<svg viewBox="0 0 80 52" class={`block ${className}`} aria-hidden="true">
  <defs>
    <clipPath id="fanlightArch">
      <path d="M4,52 L4,24 Q10,5 40,3 Q70,5 76,24 L76,52 Z"></path>
    </clipPath>
  </defs>
  <g clip-path="url(#fanlightArch)" opacity="0.9">
    <rect x="2" y="0" width="19" height="52" fill="#1F6B86"></rect>
    <rect x="21" y="0" width="19" height="52" fill="#3B6B4A"></rect>
    <rect x="40" y="0" width="19" height="52" fill="#7C2D2D"></rect>
    <rect x="59" y="0" width="19" height="52" fill="#B08A46"></rect>
  </g>
  <g fill="none" stroke="#B08A46" stroke-width="1.4" stroke-linejoin="round">
    <path d="M4,52 L4,24 Q10,5 40,3 Q70,5 76,24 L76,52"></path>
    <line x1="21" y1="52" x2="21" y2="6"></line>
    <line x1="40" y1="52" x2="40" y2="3"></line>
    <line x1="59" y1="52" x2="59" y2="6"></line>
  </g>
</svg>
