---
// A labelled grey placeholder box standing in for a real image until
// assets arrive. No real photos or drawings are referenced yet.
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<div
  class={`flex items-center justify-center bg-stone text-navy/50 border border-navy/10 select-none ${className}`}
>
  <span class="font-body text-sm tracking-wide uppercase">{label}</span>
</div>
