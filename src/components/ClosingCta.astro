---
import Button from "./Button.astro";
import Star from "./Star.astro";
---

<section class="bg-navy text-paper naqsh-light">
  <div class="mx-auto max-w-4xl px-4 py-28 text-center">
    <Star tone="brass" class="mx-auto mb-8 h-5 w-5" />
    <h2 class="text-2xl leading-snug sm:text-4xl">
      Designing Bahrain like it belongs to Bahrain.
    </h2>
    <div class="mt-10">
      <Button href="/work-with-me" variant="light-outline">Work with me</Button>
    </div>
  </div>
</section>
