---
// TODO: confirm real Substack URL and pull the latest few posts.
// For now this is a static placeholder list, no live feed.
const journalUrl = "https://turathi.substack.com";
const posts = [
  { title: "Placeholder post title one", date: "Coming soon" },
  { title: "Placeholder post title two", date: "Coming soon" },
  { title: "Placeholder post title three", date: "Coming soon" },
];
---

<section class="bg-stone/60">
  <div class="max-w-6xl mx-auto px-4 py-24">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm uppercase tracking-wider text-accent">Journal</p>
        <h2 class="mt-3 text-2xl sm:text-3xl text-navy">Latest writing</h2>
      </div>
      <a
        href={journalUrl}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline text-navy/80 hover:text-navy text-sm"
      >
        Read on Substack
      </a>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        posts.map((p) => (
          <a
            href={journalUrl}
            target="_blank"
            rel="noopener"
            class="block bg-white border border-navy/10 p-6 hover:border-navy/30 transition-colors"
          >
            <p class="text-xs uppercase tracking-wider text-navy/40">{p.date}</p>
            <h3 class="mt-2 text-lg text-navy">{p.title}</h3>
          </a>
        ))
      }
    </div>
  </div>
</section>
