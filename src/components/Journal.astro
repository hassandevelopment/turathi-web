---
import Eyebrow from "./Eyebrow.astro";
import ArchCrown from "./ArchCrown.astro";

// TODO: confirm real Substack URL and pull the latest few posts.
// For now this is a static placeholder list, no live feed.
const journalUrl = "https://turathi.substack.com";
const posts = [
  { title: "Placeholder post title one", date: "Coming soon" },
  { title: "Placeholder post title two", date: "Coming soon" },
  { title: "Placeholder post title three", date: "Coming soon" },
];
---

<section class="border-y border-brass/15 bg-stone/50 naqsh">
  <div class="mx-auto max-w-6xl px-4 py-24">
    <div class="flex items-end justify-between gap-4">
      <div>
        <Eyebrow>Journal</Eyebrow>
        <h2 class="mt-4 text-2xl text-navy sm:text-3xl">Latest writing</h2>
        <p class="mt-4 max-w-lg text-navy/70">
          I write down the arguments I can't fit into a caption. Longer thoughts
          on building a Bahrain that still feels like Bahrain.
        </p>
      </div>
      <a
        href={journalUrl}
        target="_blank"
        rel="noopener"
        class="hidden text-sm text-navy/80 underline-offset-8 decoration-brass hover:text-navy hover:underline sm:inline"
      >
        Read on Substack
      </a>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        posts.map((p) => (
          <a
            href={journalUrl}
            target="_blank"
            rel="noopener"
            class="block border-t-2 border-brass/70 bg-paper px-6 pb-6 pt-5 transition-colors hover:border-brass"
          >
            <ArchCrown class="mb-4 w-10" />
            <p class="text-xs uppercase tracking-[0.2em] text-navy/40">{p.date}</p>
            <h3 class="mt-2 text-lg text-navy">{p.title}</h3>
          </a>
        ))
      }
    </div>
  </div>
</section>
