---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import ArchCrown from "./ArchCrown.astro";

// Tier definitions are facts only Turathi confirms. Kept as labelled placeholders.
const tiers = [
  { name: "Tier one", body: "Tier definition to be confirmed (placeholder)." },
  { name: "Tier two", body: "Tier definition to be confirmed (placeholder)." },
  { name: "Tier three", body: "Tier definition to be confirmed (placeholder)." },
];
---

<section class="bg-navy text-paper naqsh-light">
  <div class="mx-auto max-w-6xl px-4 py-24">
    <Eyebrow>The Turathi Octagon</Eyebrow>
    <h2 class="mt-4 text-2xl sm:text-3xl">What it is</h2>
    <span class="mt-4 block h-px w-16 bg-brass"></span>
    <p class="mt-4 max-w-2xl text-paper/75">
      The Turathi Octagon is how I honour the places that kept their heritage
      alive, in their food, their form and the way they treat a guest. Tradition
      isn't nostalgia. It's the better answer we stopped using.
    </p>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        tiers.map((t) => (
          <div class="border border-paper/15 px-6 pb-6 pt-5">
            <ArchCrown tone="light" class="mx-auto mb-4 w-12" />
            <h3 class="text-center text-xl">{t.name}</h3>
            <p class="mt-2 text-center text-sm text-paper/70">{t.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12">
      <Button href="/the-turathi-octagon" variant="light-outline">Explore the Octagon</Button>
    </div>
  </div>
</section>
