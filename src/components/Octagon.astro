---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import Star from "./Star.astro";

// The Turathi Octagon tiers: a star rating for restaurants that embody the
// finest traditions of their cuisine and heritage.
const tiers = [
  { stars: 1, name: "Fine Cooking", body: "Well made, rooted in tradition." },
  { stars: 2, name: "Distinguished Table", body: "A vivid sense of place." },
  { stars: 3, name: "Cultural Landmark", body: "A living expression of its heritage." },
];
---

<section class="bg-navy text-paper naqsh-light">
  <div class="mx-auto max-w-6xl px-4 py-24">
    <div>
      <h2 class="text-3xl sm:text-5xl">The Turathi Octagon</h2>
      <Eyebrow class="mt-4">What it is</Eyebrow>
      <span class="mt-5 block h-px w-16 bg-brass"></span>
      <p class="mt-4 max-w-2xl text-paper/75">
        It's how I honour restaurants that embody the finest traditions of their
        cuisine and heritage. Tradition isn't nostalgia. It's the better answer
        we stopped using.
      </p>
      <p class="mt-4 max-w-2xl text-paper/60">
        Three tiers, one to three stars, mark how fully a place carries its
        heritage.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-3">
      {
        tiers.map((t) => (
          <div class="border border-paper/15 px-6 pb-6 pt-6 text-left sm:text-center">
            <div class="flex items-center justify-start gap-1.5 sm:justify-center">
              {Array.from({ length: t.stars }).map(() => (
                <Star tone="brass" class="h-4 w-4" />
              ))}
            </div>
            <h3 class="mt-4 text-xl">{t.name}</h3>
            <p class="mt-2 text-sm text-paper/70">{t.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12">
      <Button href="/the-turathi-octagon" variant="light-outline">Explore the Octagon</Button>
    </div>
  </div>
</section>
