---
import Button from "./Button.astro";

const tiers = [
  { name: "Tier one", body: "Placeholder tier description." },
  { name: "Tier two", body: "Placeholder tier description." },
  { name: "Tier three", body: "Placeholder tier description." },
];
---

<section class="bg-navy text-white">
  <div class="max-w-6xl mx-auto px-4 py-24">
    <p class="text-sm uppercase tracking-wider text-accent">The Turathi Octagon</p>
    <h2 class="mt-3 text-2xl sm:text-3xl">What it is</h2>
    <p class="mt-4 text-white/70 max-w-2xl">
      Placeholder explanation of the Turathi Octagon and how the tiers work.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        tiers.map((t) => (
          <div class="border border-white/15 p-6">
            <h3 class="text-xl">{t.name}</h3>
            <p class="mt-2 text-white/70 text-sm">{t.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10">
      <Button href="/the-turathi-octagon" variant="light-outline">Explore the Octagon</Button>
    </div>
  </div>
</section>
