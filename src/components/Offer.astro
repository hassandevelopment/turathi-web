---
import Button from "./Button.astro";

const offerings = [
  {
    title: "Interiors",
    body: "Rooms that hold shade, air and calm the way our old houses did, made for how we live now.",
  },
  {
    title: "Buildings",
    body: "Buildings with ornament, craft and meaning, not another lifeless glass block.",
  },
  {
    title: "Consultation",
    body: "Sit with me before you build, and we work out how your project can belong to Bahrain.",
  },
];
---

<section class="max-w-6xl mx-auto px-4 py-24">
  <h2 class="text-2xl sm:text-3xl text-navy">What I design</h2>
  <p class="mt-3 text-navy/70 max-w-2xl">
    I design for people first: interiors, buildings and the thinking behind
    them, all rooted in how we actually live here.
  </p>

  <div class="mt-10 grid gap-6 sm:grid-cols-3">
    {
      offerings.map((o) => (
        <div class="border border-navy/10 p-6">
          <h3 class="text-xl text-navy">{o.title}</h3>
          <p class="mt-2 text-navy/70 text-sm">{o.body}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-10">
    <Button href="/work-with-me">Work with me</Button>
  </div>
</section>
