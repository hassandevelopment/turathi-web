---
import Button from "./Button.astro";
import ArchCrown from "./ArchCrown.astro";

const offerings = [
  {
    title: "Interiors",
    body: "Rooms that hold shade, air and calm the way our old houses did, made for how we live now.",
  },
  {
    title: "Buildings",
    body: "Buildings with ornament, craft and meaning, not another lifeless glass block.",
  },
  {
    title: "Consultation",
    body: "Sit with me before you build, and we work out how your project can belong to Bahrain.",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-24">
  <h2 class="text-2xl text-navy sm:text-3xl">What I design</h2>
  <span class="mt-4 block h-px w-16 bg-brass"></span>
  <p class="mt-4 max-w-2xl text-navy/70">
    I design for people first: interiors, buildings and the thinking behind
    them, all rooted in how we actually live here.
  </p>

  <div class="mt-12 grid gap-6 sm:grid-cols-3">
    {
      offerings.map((o) => (
        <div class="border border-navy/10 bg-paper px-6 pb-6 pt-5">
          <ArchCrown class="mx-auto mb-4 w-12" />
          <h3 class="text-center text-xl text-navy">{o.title}</h3>
          <p class="mt-2 text-center text-sm text-navy/70">{o.body}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-12">
    <Button href="/work-with-me">Work with me</Button>
  </div>
</section>
